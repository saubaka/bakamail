# BakaMail 部署配置（复制为 bakamail.env）
#
# 与邮局同域：mail.saubaka.com 的 80/443 归 openresty，25/143/465/587/993 归 maddy。

# 会话与指纹签名密钥。生产必须固定成一串随机值，否则每次重启都会让
# 所有会话失效、限流计数清零。用 `openssl rand -base64 48` 生成。
SECRET_KEY=replace-with-a-long-random-string

# 生产走 HTTPS，保持 1
COOKIE_SECURE=1
PUBLIC_ORIGIN=https://mail.saubaka.com
TRUST_LOOPBACK_PROXY=1
# Verify the Docker network gateway before setting this exact IP.
TRUSTED_PROXY_IPS=172.18.0.1

MAIL_DOMAIN=saubaka.com
MAIL_TLS_REJECT_UNAUTHORIZED=true

# 首次启动创建的管理员（仅在库里没有管理员时生效）
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_ADMIN_PASSWORD=

# 安全阈值
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
REGISTER_MAX_PER_HOUR=3
REGISTER_MAX_PER_DAY=10
GLOBAL_FAILURE_ALERT=50
MAIL_SESSION_DAYS=7
ADMIN_SESSION_IDLE_MINUTES=30

# 自动化测试专用开关，生产必须保持 0
HUMAN_CHECK_TEST_MODE=0
