# BakaMail 部署配置（复制为 bakamail.env）
#
# 网页的 80/443 与邮局协议端口独立；下面的域名与资源名请按实际部署填写。

# 会话与指纹签名密钥。生产必须固定成一串随机值，否则每次重启都会让
# 所有会话失效、限流计数清零。用 `openssl rand -base64 48` 生成。
SECRET_KEY=replace-with-a-long-random-string

# 生产走 HTTPS，保持 1
COOKIE_SECURE=1
PUBLIC_ORIGIN=https://mail.example.com
TRUST_LOOPBACK_PROXY=1
# Verify the Docker network gateway before setting this exact IP.
TRUSTED_PROXY_IPS=

MAIL_HOST=maddy
MAIL_HOSTNAME=mail.example.com
MAIL_DOMAIN=example.com
MAIL_IMAP_PORT=993
MAIL_SMTP_PORT=465
MAIL_SMTP_ALT_PORT=587
MAIL_TLS_REJECT_UNAUTHORIZED=true

# 首次网页初始化所需密钥位于应用持久目录 setup.key，勿公开或提交。
# Compose 插值从 --env-file 读取：填写实际 Maddy 网络及数据卷名。
MADDY_NETWORK=mail-network
MADDY_VOLUME=maddydata
MADDY_CONTAINER=maddy
# 日志快照为可选功能。设置为已经部署好的受限采集目录。
MAIL_LOG_DIRECTORY=./mail-logs
MAIL_LOG_SNAPSHOT_PATH=

# 安全阈值
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
REGISTER_MAX_PER_HOUR=3
REGISTER_MAX_PER_DAY=10
GLOBAL_FAILURE_ALERT=50
MAIL_SESSION_DAYS=7
ADMIN_SESSION_IDLE_MINUTES=30

# 自动化测试专用开关，生产必须保持 0
HUMAN_CHECK_TEST_MODE=0
