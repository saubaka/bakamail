# 反向代理（Nginx / OpenResty / 1Panel 反向代理站点）：后端没起来或超时时，
# 代理自己会返回 502/503/504，应用来不及渲染，这里用静态页保持同样的外观。
#
# 1. 把本目录里的 500.html、502.html、503.html、504.html 复制到服务器，例如 /opt/bakamail/error-pages/
# 2. 把下面的内容放进站点的 server 块，并把 alias 改成上面的目录（末尾保留斜杠）
# 3. 重新加载代理配置
#
# 应用自己返回的错误页（404、500 等）已经是统一风格，不需要也不应该开启 proxy_intercept_errors。
error_page 500 /_bakamail_errors/500.html;
error_page 502 /_bakamail_errors/502.html;
error_page 503 /_bakamail_errors/503.html;
error_page 504 /_bakamail_errors/504.html;

location ^~ /_bakamail_errors/ {
    internal;
    alias /opt/bakamail/error-pages/;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
}
