# BakaMail 后端配置（复制为 .env 或交给 compose 注入）

# 监听地址，只绑回环，公网由 openresty 反代
HOST=127.0.0.1
PORT=8790

# 邮局容器在 1panel-network 里的别名；本机开发时可改成 mail.saubaka.com
MAIL_HOST=maddymail
MAIL_IMAP_PORT=993
MAIL_SMTP_PORT=465
MAIL_SMTP_ALT_PORT=587
MAIL_DOMAIN=saubaka.com
# 开发环境连公网邮局时需要真证书校验；容器内网自签可设为 true
MAIL_TLS_REJECT_UNAUTHORIZED=true

# 本地数据目录（SQLite、备份）
DATA_DIR=./data

# 生产走 HTTPS 时保持 1；本地 http 调试需要设为 0，否则浏览器不回传会话 Cookie
COOKIE_SECURE=1
# Loopback 1Panel proxy must overwrite forwarded headers. Set 0 for direct local access.
TRUST_LOOPBACK_PROXY=1
# Optional comma-separated exact proxy IPs, verified on the deployed network.
# Docker loopback publishing may use the bridge gateway. Do NOT use CIDR or wildcard.
TRUSTED_PROXY_IPS=
# Optional exact browser origin, no trailing slash; e.g. https://mail.saubaka.com.
# Leave empty locally: compare Origin against request protocol + Host (Vite keeps Host).
PUBLIC_ORIGIN=

# 会话与指纹签名密钥，生产必须固定，否则重启后全部会话与限流失效
SECRET_KEY=change-me-to-a-long-random-string

# 账号生命周期命令的执行方式：
#   local        直接调用 maddy 二进制（生产：容器内已 COPY，卷挂在 /data）
#   docker-exec  通过 docker exec 调用（需要挂 docker socket，不推荐）
#   disabled     禁用（本地开发用，相关接口返回明确错误）
MADDY_RUNNER=local
MADDY_BIN=/usr/local/bin/maddy
MADDY_DATA_DIR=/data
MADDY_CONTAINER=1Panel-maddy-mail-izag

# 首次启动时自动创建的管理员（仅当库里没有管理员时生效）
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_ADMIN_PASSWORD=

# 安全阈值
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
ADMIN_LOGIN_MAX_FAILURES=3
ADMIN_LOGIN_LOCK_MINUTES=30
MIN_FORM_SECONDS=2
# Forbidden unless NODE_ENV=test; never enable in a real instance.
HUMAN_CHECK_TEST_MODE=0
REGISTER_MAX_PER_HOUR=3
# Per-source sliding 24-hour budget (successful and failed requests).
REGISTER_MAX_PER_DAY=10
GLOBAL_FAILURE_ALERT=50
